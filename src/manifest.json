{
  "manifest_version": 3,
  "name": "OptionYar | آپشن‌یار",
  "short_name": "OptionYar",
  "version": "1.0.0",
  "description": "دستیار هوشمند برای شکار فرصت‌های سود نامتقارن در بازار اختیار معامله.",
  "icons": {
    "16": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OptionYar Assistant",
    "default_icon": "logo192.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://opyar.ir/*",
    "https://optnyar.ir/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo192.png",
        "logo512.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
